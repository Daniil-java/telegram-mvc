<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.kuklin</groupId>
    <artifactId>telegram-mvc-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>telegram-mvc</name>
    <description>Annotation-driven Telegram bots for Spring Boot, in the style of Spring MVC</description>

    <url>https://github.com/Daniil-java/telegram-mvc</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Daniil Kuklin</name>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/Daniil-java/telegram-mvc</url>
        <connection>scm:git:https://github.com/Daniil-java/telegram-mvc.git</connection>
    </scm>

    <modules>
        <module>telegram-mvc-core</module>
        <module>examples/simple-bot</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <telegrambots.version>6.9.7.1</telegrambots.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.kuklin</groupId>
                <artifactId>telegram-mvc-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.telegram</groupId>
                <artifactId>telegrambots</artifactId>
                <version>${telegrambots.version}</version>
                <exclusions>
                    <!-- Spring ships its own commons-logging bridge (spring-jcl) -->
                    <exclusion>
                        <groupId>commons-logging</groupId>
                        <artifactId>commons-logging</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
